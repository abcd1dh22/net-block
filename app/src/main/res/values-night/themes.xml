<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TimeBlocker" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ui_bg</item>
        <item name="android:statusBarColor">@color/ui_bg</item>
        <item name="android:navigationBarColor">@color/ui_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/ui_primary</item>
        <item name="android:colorControlActivated">@color/ui_primary</item>
    </style>

    <style name="Theme.TimeBlocker.Block" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/block_bg</item>
        <item name="android:statusBarColor">@color/block_bg</item>
        <item name="android:navigationBarColor">@color/block_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/ui_primary</item>
    </style>
</resources>
