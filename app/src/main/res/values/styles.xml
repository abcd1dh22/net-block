<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Card">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <style name="Row">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="RowLabel">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ui_label</item>
    </style>

    <style name="RowValue">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ui_secondary</item>
    </style>

    <style name="CardTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ui_label</item>
    </style>

    <style name="PageTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ui_label</item>
    </style>

    <style name="SectionHeader">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ui_secondary</item>
    </style>

    <style name="Footer">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ui_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="PillButton">
        <item name="android:background">@drawable/bg_pill_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="PillWhite">
        <item name="android:background">@drawable/bg_pill_white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/block_bg</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ObTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">27sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ui_label</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="ObBody">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ui_secondary</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="InfoHead">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ui_primary</item>
    </style>

    <style name="InfoText">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ui_label</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>
